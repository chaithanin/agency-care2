# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง — ห้าม commit .env
PORT=4000
DB_FILE=./data/chat-inbox.db

# LINE Messaging API (Console > Channel settings)
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# true = ไม่ยิงข้อความออก LINE จริง (ใช้ตอนทดสอบในเครื่อง)
LINE_DRY_RUN=true

WEBHOOK_TIMEOUT_MS=5000

# ── respond.io Developer API ──────────────────────────────
# สร้าง token ที่ respond.io → Settings → Integrations → Developer API → Add Access Token
# (ต้องเป็นแผน Growth ขึ้นไป)  ห้าม commit ค่านี้
RESPONDIO_API_TOKEN=
RESPONDIO_API_BASE=https://api.respond.io/v2
RESPONDIO_TIMEZONE=Asia/Bangkok
RESPONDIO_PAGE_SIZE=100
RESPONDIO_MESSAGES_PER_CONTACT=50
RESPONDIO_MAX_RETRIES=4
RESPONDIO_TIMEOUT_MS=20000
